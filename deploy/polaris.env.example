# Required: encrypts sensitive columns and signs sessions. Keep it secret and backed up.
POLARIS_SECRET_KEY=change-me-to-a-long-random-string
# Hide the admin UI/API under a secret path; every other path returns 404.
POLARIS_ADMIN_PATH=/x7k2
# Public base URL used in subscription links (behind Caddy/Nginx).
POLARIS_PUBLIC_URL=https://panel.example.com
POLARIS_LISTEN=127.0.0.1:8080
# mTLS endpoint agents dial; open this port in your firewall.
POLARIS_AGENT_LISTEN=:9443
POLARIS_AGENT_HOSTS=panel.example.com
POLARIS_DATA_DIR=/var/lib/polaris
# Optional
# POLARIS_DB_DSN=postgres://polaris:pass@127.0.0.1:5432/polaris?sslmode=disable
# POLARIS_REDIS_URL=redis://127.0.0.1:6379/0
# POLARIS_DECOY=https://www.example.org
POLARIS_INITIAL_ADMIN_USERNAME=admin
# POLARIS_INITIAL_ADMIN_PASSWORD=   # generated and logged on first start when empty
